 #define MAXTAGLOOP	100
 
 
+/* CellJoker: fast paths for the table reads and writes that the game does most. Each one
+** gives the same result as the full path, which it skips: luaV_gettable -> luaH_get ->
+** luaH_getstr is three calls per field read. NULL means "take the full path".
+*/
+#if defined(__GNUC__)
+#define fast_inline __attribute__((always_inline)) static inline
+#else
+#define fast_inline static
+#endif
+
+/* The slot of a string key in the hash part, or NULL if the key is absent. */
+fast_inline TValue *fast_strslot (Table *h, TString *key) {
+  Node *n = gnode(h, lmod(key->tsv.hash, sizenode(h)));
+  do {
+    if (ttisstring(gkey(n)) && rawtsvalue(gkey(n)) == key)
+      return gval(n);
+    n = gnext(n);
+  } while (n);
+  return NULL;
+}
+
+/* A nil read is final only when no __index can apply, as in luaV_gettable. */
+fast_inline const TValue *fast_result (Table *h, const TValue *slot) {
+  if (slot != NULL && !ttisnil(slot)) return slot;
+  return h->metatable == NULL ? luaO_nilobject : NULL;
+}
+
+fast_inline const TValue *fast_getstr (Table *h, TString *key) {
+  return fast_result(h, fast_strslot(h, key));
+}
+
+/* A string key, or an integer key in the array part, as luaH_get finds them. */
+fast_inline const TValue *fast_get (const TValue *t, const TValue *key) {
+  Table *h;
+  if (!ttistable(t)) return NULL;
+  h = hvalue(t);
+  if (ttisstring(key)) return fast_getstr(h, rawtsvalue(key));
+  if (ttisnumber(key)) {
+    int k;
+    lua_Number n = nvalue(key);
+    lua_number2int(k, n);
+    if (luai_numeq(cast_num(k), n) &&
+        cast(unsigned int, k-1) < cast(unsigned int, h->sizearray))
+      return fast_result(h, &h->array[k-1]);
+  }
+  return NULL;
+}
+
+/* An existing, non-nil string field: luaV_settable's first case. */
+fast_inline TValue *fast_setslot (const TValue *t, const TValue *key) {
+  TValue *slot;
+  if (!ttistable(t) || !ttisstring(key)) return NULL;
+  slot = fast_strslot(hvalue(t), rawtsvalue(key));
+  return (slot != NULL && !ttisnil(slot)) ? slot : NULL;
+}
+
+
